includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 5

    paths:
        - src
        - database
        - config

    treatPhpDocTypesAsCertain: false

    # Larastan only knows the host app's config directory; this is the
    # package's own, where env() is exactly right.
    ignoreErrors:
        -
            identifier: larastan.noEnvCallsOutsideOfConfig
            path: config/smartlinks.php

        # Core's Entries\QueryBuilder contract is an empty marker interface;
        # every implementation (Stache and the Eloquent driver) has where()/whereIn().
        -
            message: '#^Call to an undefined method Statamic\\Contracts\\Entries\\QueryBuilder::where(In)?\(\)\.$#'
            identifier: method.notFound
